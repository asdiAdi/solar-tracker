{
  "name": "solar-tracker-backend",
  "private": true,
  "scripts": {
    "bundle": "esbuild lambda/solar-data.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/index.js --external:aws-sdk",
    "build": "tsc --noEmit",
    "synth": "npm run bundle && cdk synth",
    "deploy": "npm run bundle && cdk deploy --require-approval never",
    "test:live": "node test/fetch-live.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.5.0",
    "aws-cdk": "^2.1140.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
