{
  "name": "solar-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run synth",
    "build:vite": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bundle": "esbuild infra/lambda/solar-data.ts --bundle --platform=node --target=node24 --format=cjs --outfile=infra/dist-lambda/index.js --external:aws-sdk",
    "synth": "npm run bundle && cdk synth -o dist-infra",
    "deploy": "npm run bundle && cdk deploy --all --require-approval never",
    "test:live": "node infra/test/fetch-live.mjs"
  },
  "dependencies": {
    "@asdi/aws-infra": "^0.1.3",
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "aws-cdk": "^2.1140.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "Simple PWA Solar Tracking app to track and estimate expenses.",
  "main": "index.js",
  "keywords": []
}
